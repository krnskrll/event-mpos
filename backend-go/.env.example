# Single value that changes across environments (local → Supabase → AWS RDS).
# Local Docker:
DB_URL=postgres://eventmpos:eventmpos@localhost:5432/eventmpos?sslmode=disable
# Supabase (use the DIRECT connection on 5432 for migrations, not the 6543 pooler):
# DB_URL=postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ENABLED=true

# Base64-encoded 256-bit secret. MUST be overridden in production.
JWT_SECRET=ZHYtbG9jYWwtZGV2LXNlY3JldC1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0xMjM0
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=7

ERP_SOURCE=mock
MEMBER_SOURCE=mock
# For ERP_SOURCE=file / MEMBER_SOURCE=file, sample CSVs live in samples/:
# ERP_FILE_PATH=samples/erp/products.csv
# MEMBER_FILE_PATH=samples/members/members.csv

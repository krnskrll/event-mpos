# Single value that changes across environments (local → Supabase → AWS RDS).
# Local Docker:
DB_URL=postgres://eventmpos:eventmpos@localhost:5432/eventmpos?sslmode=disable
# Supabase (use the DIRECT connection on 5432 for migrations, not the 6543 pooler):
# DB_URL=postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

PORT=8080
SEED_ENABLED=true


MEMBER_SOURCE=mock
# For MEMBER_SOURCE=file, a sample CSV lives in samples/:
# MEMBER_FILE_PATH=samples/members/members.csv

# Bhoomy connector: mock (default) | http. http needs the URL and a service token.
BHOOMY_MODE=mock
# BHOOMY_URL=http://api:8080
# BHOOMY_SERVICE_TOKEN=
# BHOOMY_SYNC_MINUTES=5   # how often linked stores pull Produk Toko changes (http mode)

# POS photos: local folder (mount a volume in Docker) and the public URL it is served under.
# MEDIA_DIR=./media
# MEDIA_BASE_URL=http://localhost:8080/media

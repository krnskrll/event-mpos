<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera is used for barcode + member-QR scanning. Optional so the app still installs on
         hardware-scanner-only devices (e.g. Sunmi) that have no general camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".MposApplication"
        android:allowBackup="false"
        android:label="event-mpos"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventMpos"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is for local-dev HTTP against the backend. Use HTTPS in production. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EventMpos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- We configure WorkManager via Application (Configuration.Provider), so disable the default. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>

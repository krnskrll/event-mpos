<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12, and while Flutter starts: forest, the mark in a circle, the app name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_forest" />
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/brand_forest_raised" />
        </shape>
    </item>
    <item android:width="112dp" android:height="112dp" android:gravity="center" android:drawable="@drawable/bhoomy_mark" />
    <item android:width="200dp" android:height="80dp" android:gravity="bottom|center_horizontal" android:bottom="16dp"
        android:drawable="@drawable/splash_brand" />
</layer-list>
